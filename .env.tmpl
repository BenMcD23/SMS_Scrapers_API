# Deployment environment. The compose overrides set this for the dev and prod
# containers; set it here when running uvicorn directly. Anything other than
# "dev" is treated as prod, which hides the interactive API docs.
ENV=dev

POSTGRES_PASSWORD=""
ENCRYPTION_KEY=""
GITHUB_TOKEN=""
CLOUDFLARE_TUNNEL_TOKEN=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_IMPERSONATE_EMAIL=noreply@317atc.co.uk

NOREPLY_EMAIL=noreply@317atc.co.uk

# text message
NOTIFY_API_KEY=
NOTIFY_SMS_TEMPLATE_ID=71134f0e-a6e5-4967-9912-5c09e2c50bb2
ALERT_EMAIL=notifications@317atc.co.uk  # who to send mail to when text message isnt set

GEMINI_API_KEY=
GROQ_API_KEY=

# Pre-shared key for the Google Form uniform order importer. This is the only
# endpoint not behind a Google token, so leaving it unset disables the import
# rather than leaving it open.
UNIFORM_FORM_API_KEY=

# How long audit rows are kept, in days. Longer than the 182-day order and
# assessment cleanups on purpose — a safeguarding trail should outlive the
# records it describes.
AUDIT_RETENTION_DAYS=365

# Committee request tracker — OC gets submission notifications and gates
# approvals; the committee gets purchase and payment requests.
OC_EMAIL=
COMMITTEE_EMAIL=

EMAIL_DISABLED=true/fase

# Database backups to Google Drive. Set DB_BACKUP_ENABLED=true only in the prod
# .env so the daily 03:00 job runs there and not in dev. The Shared Drive folder
# defaults to the backups folder; override here if it changes.
DB_BACKUP_ENABLED=false
DB_BACKUP_DRIVE_FOLDER_ID=1Bi5CmjUVObZfarx2FUqECNJvBg3R1MeQ
DB_BACKUP_RETENTION=14

CORS_ALLOW_LOCALHOST=true
