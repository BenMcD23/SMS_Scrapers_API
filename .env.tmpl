# Neon connection strings. The worker (and local dev) use the DIRECT url — it
# holds a handful of long-lived connections, which is what the direct endpoint
# is for. The Lambda gets the POOLED (-pooler) url instead, set on the function
# rather than here.
DATABASE_URL=""
# Only needed where DATABASE_URL is the pooled endpoint (i.e. on the Lambda):
# pg_dump and psql can't work through PgBouncer, so backups and restores use
# this. Leave blank when DATABASE_URL is already direct.
DATABASE_DIRECT_URL=""

# Only used by the local-dev Postgres in docker-compose.local.yml.
POSTGRES_PASSWORD=""
ENCRYPTION_KEY=""
GITHUB_TOKEN=""
CLOUDFLARE_TUNNEL_TOKEN=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_IMPERSONATE_EMAIL=noreply@317atc.co.uk

NOREPLY_EMAIL=noreply@317atc.co.uk

# text message
NOTIFY_API_KEY=
NOTIFY_SMS_TEMPLATE_ID=71134f0e-a6e5-4967-9912-5c09e2c50bb2
ALERT_EMAIL=notifications@317atc.co.uk  # who to send mail to when text message isnt set

GEMINI_API_KEY=
GROQ_API_KEY=
# GLM 5.2 via build.nvidia.com's free endpoint — the fallback for when Gemini
# 3.5 Flash's 20/day runs out. Leave blank and the chain just skips it.
NVIDIA_API_KEY=

# Committee request tracker — OC gets submission notifications and gates
# approvals; the committee gets purchase and payment requests.
OC_EMAIL=
COMMITTEE_EMAIL=

LEAVING_PROCESS_REPLY_TO=

# NCO session plans — who gets told when a plan is submitted for approval.
# Defaults to the notifications group; the NCO's own notifications go to them.
SESSION_PLAN_ALERT_EMAIL=notifications@317atc.co.uk
# NCO holidays — the shared Google Calendar their bookings are written to as
# all-day events. Share that calendar with GOOGLE_IMPERSONATE_EMAIL giving it
# "Make changes to events", then paste its calendar ID here. Left blank,
# holidays still save in the SMS but aren't pushed to Calendar.
NCO_HOLIDAY_CALENDAR_ID=c_82de82f5cdbb2d1baa6a2eb2bb072125c83c6297cc9afc942537f878813155ee@group.calendar.google.com

# Base URL of the SMS site, used for the "open this plan" links in emails.
SITE_BASE_URL=https://sms.317atc.co.uk

EMAIL_DISABLED=true/fase

# Database backups to Google Drive. These belong on the LAMBDA now (the daily
# 03:00 EventBridge rule invokes it there), not on the worker. Set
# DB_BACKUP_ENABLED=true only for prod. Neon's free tier has no downloadable
# backups, so this is the only recovery path — check the first few real runs.
DB_BACKUP_ENABLED=false
DB_BACKUP_DRIVE_FOLDER_ID=1Bi5CmjUVObZfarx2FUqECNJvBg3R1MeQ
DB_BACKUP_RETENTION=14

CORS_ALLOW_LOCALHOST=true

# Set false on a home API running alongside a live Lambda, so the in-process
# scheduler doesn't fire the same jobs the EventBridge rules already do.
ENABLE_LOCAL_SCHEDULER=true

DEV_FAKE_AUTH=1 
